# Installation settings for compose.yaml: copy to .env next to it and fill in.

# Version of the app: `main` follows every validated change, a number such as 0.1.0 stays on that release.
MAILBOX_VERSION=main

# Password of the database. Letters and digits only, as it goes into a connection address.
# Generate one with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Key that encrypts the secrets kept in the database, such as the one of your authenticator app.
# Generate it with: openssl rand -base64 32
# Keep a copy outside this machine: without it, an encrypted secret cannot be read back. Changing it
# means resetting the access (see "Lost access" in the README).
MAILBOX_SECRET_KEY=

# Address you open the app at, over HTTPS: the one your HTTPS endpoint gives, such as
# https://mail.your-tailnet.ts.net for `tailscale serve`. Passkeys are tied to its host name:
# changing it later stops every passkey from working.
MAILBOX_URL=

# To connect Gmail mailboxes: the OAuth client you create for this installation in Google Cloud.
# Leave both empty to do without Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Folder holding the database. Keep it on an SSD.
MAILBOX_DATABASE_DIRECTORY=./data/database

# Folder receiving the nightly backups (the 7 most recent are kept), ideally on another disk than
# the database. It must exist and be writable by the user with uid 1000.
MAILBOX_BACKUP_DIRECTORY=./data/backups

# Port of the app on this machine, reachable from the machine itself only.
MAILBOX_PORT=3000

# Time zone, e.g. Europe/Paris: the nightly backup runs at 3 a.m. in this zone.
TZ=UTC

# One of fatal, error, warn, info, debug, trace, silent. Keep warn or more verbose: the setup code
# of the first start is written at the warn level.
LOG_LEVEL=info
