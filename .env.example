# Production configuration: copy to .env and adjust. Every variable is validated at startup.

# PostgreSQL connection string used by the api.
DATABASE_URL=postgres://mailbox:change-me@postgres:5432/mailbox

# Address and port the api listens on (defaults: 127.0.0.1 and 3000). Inside a container, use 0.0.0.0.
API_HOST=0.0.0.0
API_PORT=3000

# Folder of the built web app (apps/web/dist), served by the api. Unset, the api serves its API only.
WEB_DIRECTORY=/app/web

# One of fatal, error, warn, info, debug, trace, silent. Default: info.
LOG_LEVEL=info

# Folder where the worker writes the nightly database backup (the 7 most recent are kept).
BACKUP_DIRECTORY=/backups

# Port of the worker health check, reachable from inside its container only. Default: 3001.
WORKER_HEALTH_PORT=3001

# Time zone, e.g. Europe/Paris: the nightly backup runs at 3 a.m. in this zone. Default: UTC.
TZ=UTC
