# Production configuration: copy to .env and adjust. Every variable is validated at startup.

# PostgreSQL connection string used by the api.
DATABASE_URL=postgres://mailbox:change-me@postgres:5432/mailbox

# Address and port the api listens on (defaults: 127.0.0.1 and 3000). Inside a container, use 0.0.0.0.
API_HOST=0.0.0.0
API_PORT=3000

# One of fatal, error, warn, info, debug, trace, silent. Default: info.
LOG_LEVEL=info
