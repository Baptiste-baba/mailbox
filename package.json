{
  "name": "mailbox",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "dev": "pnpm db:start && turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "test": "pnpm db:start && turbo run build && vitest run",
    "db:start": "docker compose --file compose.dev.yaml up --detach --wait"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "turbo": "2.11.10",
    "vitest": "catalog:"
  }
}
